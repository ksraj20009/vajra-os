# === Indian Language Support ===
# fonts-indic pulls the full set of Indian-language font families
# (Devanagari, Tamil, Bengali, Gujarati, Gurmukhi, Kannada, Telugu,
# Malayalam, Odia, ...); fonts-noto in the base list adds Noto coverage
fonts-indic
fonts-lohit-deva
fonts-lohit-taml
fonts-lohit-gujr
fonts-lohit-guru
fonts-lohit-knda
fonts-lohit-telu
fonts-lohit-mlym
ibus
ibus-m17n
im-config
locales

# === Audio (PipeWire from the base list provides pulseaudio compat) ===
alsa-utils

