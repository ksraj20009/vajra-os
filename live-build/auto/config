#!/bin/bash
# ============================================================================
# Vajra OS (वज्र OS) — live-build configuration
# ============================================================================
# Configures live-build to create the bootable Vajra OS DESKTOP ISO:
# Debian trixie base, Xfce desktop, Calamares installer, the Vajra tools
# from the project's own signed APT repository (config/archives/),
# Buddhi AI, and the full branding suite (config/hooks/).
#
# Usage:   cd live-build && lb config && sudo lb build
# In CI:   scripts/build-desktop-iso.sh (runs this inside a Debian trixie
#          container — live-build needs a Debian host and root)
#
# "noauto" as the first argument is the live-build convention that stops
# lb config from re-executing this script (otherwise it recurses forever).
# ============================================================================
set -e

lb config noauto \
    --distribution trixie \
    --architecture amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --debian-installer none \
    --iso-volume "Vajra OS 1.0 Desktop" \
    --iso-publisher "Vajra OS Project; https://github.com/ksraj20009/vajra-os" \
    --iso-application "Vajra OS (वज्र OS) 1.0 — India's Privacy-First AI-Powered Desktop OS" \
    --parent-mirror-bootstrap "https://deb.debian.org/debian" \
    --parent-mirror-chroot "https://deb.debian.org/debian" \
    --parent-mirror-binary "https://deb.debian.org/debian" \
    --source false \
    --firmware-chroot true \
    --win32-loader false \
    --security true \
    --updates true \
    --bootappend-live "boot=live components locales=en_IN.UTF-8 keyboard-layouts=us username=vajra user-fullname=Vajra hostname=vajra-os timezone=Asia/Kolkata" "$@"

echo "[Vajra OS] live-build configuration complete."
echo "[Vajra OS] Build with: sudo lb build   (or scripts/build-desktop-iso.sh)"
