#!/usr/bin/env python3
"""Vajra System Monitor — CPU, memory, disk, network, processes"""
import os, sys, time, subprocess

def get_size(bytes, suffix="B"):
    for unit in ["", "K", "M", "G", "T", "P"]:
        if bytes < 1024: return f"{bytes:.1f}{unit}{suffix}"
        bytes /= 1024

def cpu_info():
    with open("/proc/stat") as f: fields = f.readline().split()
    return [int(x) for x in fields[1:]]

def cpu_usage():
    c1 = cpu_info(); time.sleep(0.5); c2 = cpu_info()
    idle = (c2[3]+c2[4]) - (c1[3]+c1[4])
    total = sum(c2) - sum(c1)
    return 100 * (total - idle) / total if total > 0 else 0

def mem_info():
    with open("/proc/meminfo") as f:
        info = {}
        for line in f:
            parts = line.split(":")
            if len(parts) == 2: info[parts[0]] = int(parts[1].strip().split()[0])
    total = info.get("MemTotal", 0) * 1024
    avail = info.get("MemAvailable", 0) * 1024
    used = total - avail
    return total, used, avail

def disk_info():
    st = os.statvfs("/")
    total = st.f_blocks * st.f_frsize
    free = st.f_bavail * st.f_frsize
    return total, free

def processes(n=10):
    try:
        out = subprocess.run(["ps", "aux", "--sort=-%cpu"], capture_output=True, text=True).stdout
        lines = out.strip().split("\n")[:n+1]
        return lines
    except: return []

def display():
    os.system("clear" if os.name != "nt" else "cls")
    print("\033[1;33m  वज्र OS System Monitor\033[0m")
    print("\033[1;37m  Dharmo Rakshati Rakshitah\033[0m")
    print("  " + "=" * 56)

    cpu = cpu_usage()
    color = "\033[1;32m" if cpu < 50 else "\033[1;33m" if cpu < 80 else "\033[1;31m"
    print(f"  {color}CPU Usage:  {cpu:5.1f}%\033[0m  {'█' * int(cpu//5):<20}")

    total, used, avail = mem_info()
    pct = used / total * 100 if total else 0
    print(f"  \033[1;36mMemory:     {get_size(used):>8} / {get_size(total):>8}  ({pct:.0f}%)\033[0m")

    dtotal, dfree = disk_info()
    print(f"  \033[1;36mDisk (/):    {get_size(dtotal-dfree):>8} / {get_size(dtotal):>8}\033[0m")

    print("  " + "=" * 56)
    print("\033[1;33m  Top Processes:\033[0m")
    for line in processes(8):
        parts = line.split()
        if parts and parts[0] != "USER":
            print(f"  {parts[0][:8]:<9} {parts[2]:>5}% {parts[3]:>5}% {' '.join(parts[10:])[:32]}")

    print("\n  Refreshing... Ctrl+C to exit")

if __name__ == "__main__":
    interval = float(sys.argv[1]) if len(sys.argv) > 1 else 3
    try:
        while True:
            display()
            time.sleep(interval)
    except KeyboardInterrupt:
        print("\n  Goodbye!")
