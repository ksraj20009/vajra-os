# /etc/network/interfaces — Vajra OS network configuration
# Loopback
auto lo
iface lo inet loopback

# Ethernet (DHCP)
allow-hotplug eth0
iface eth0 inet dhcp

# WiFi (DHCP)
allow-hotplug wlan0
iface wlan0 inet dhcp
    wpa-conf /etc/wpa_supplicant/wpa_supplicant.conf

