# /etc/fstab — Vajra OS filesystem mount table
# <device>              <mount>    <type>    <options>           <dump> <pass>
proc                    /proc       proc     defaults             0       0
sysfs                   /sys        sysfs    defaults             0       0
devtmpfs                /dev        devtmpfs defaults             0       0
devpts                  /dev/pts    devpts   gid=5,mode=620       0       0
tmpfs                   /dev/shm    tmpfs    defaults,size=512M   0       0
tmpfs                   /tmp        tmpfs    defaults,size=256M   0       0
tmpfs                   /run        tmpfs    defaults,size=128M   0       0
# Root filesystem (adjust device on install)
#LABEL=vajra-root       /           ext4     defaults,errors=remount-ro 0 1
# Swap
#LABEL=vajra-swap       none        swap     sw                   0       0
